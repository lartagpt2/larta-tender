            "name": "authorization",
            "required": true,
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "At most 100 visible tenders, newest first",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/TenderDto"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid DTO or UUID"
          },
          "401": {
            "description": "Development token required"
          },
          "403": {
            "description": "Read-only member"
          },
          "404": {
            "description": "Missing or inaccessible tender"
          },
          "409": {
            "description": "Stale revision or conflicting receipt"
          },
          "413": {
            "description": "File exceeds 20 MiB"
          },
          "503": {
            "description": "Data access disabled pending migration approval"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "tags": ["tenders"]
      },
