  "info": {
    "title": "Larta Tender API",
    "description": "",
    "version": "1.1",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "HealthDto": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "larta-tender"
          },
          "persistence": {
            "type": "string",
            "example": "not-configured",
            "description": "Database connection is not probed."
          }
        },
        "required": ["status", "service", "persistence"]
      },
      "TenderDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "revision": {
            "type": "number"
          }
        },
        "required": ["id", "title", "revision"]
      },
      "ScopeItemDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 500
          },
          "quantity": {
            "type": "string",
            "example": "2.000001",
            "description": "Positive NUMERIC(18,6) as text"
          },
          "unit": {
            "type": "string",
            "maxLength": 40
          }
        },
        "required": ["name", "quantity", "unit"]
      },
      "CreateTenderDto": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 300,
            "example": "Synthetic tender"
          },
          "creationMode": {
            "type": "string",
            "enum": ["title", "manual", "specification"]
          },
          "items": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScopeItemDto"
            }
          }
        },
        "required": ["title"]
      },
      "ScopeItemStateDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 500
          },
          "quantity": {
            "type": "string",
            "example": "2.000001",
            "description": "Positive NUMERIC(18,6) as text"
          },
          "unit": {
            "type": "string",
            "maxLength": 40
          },
          "id": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": ["name", "quantity", "unit", "id"]
      },
      "ScopeStateDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "title": {
            "type": "string"
          },
          "revision": {
            "type": "number"
          },
          "selectionMode": {
            "type": "string",
            "enum": ["lot", "items"]
          },
          "specificationSkipped": {
            "type": "boolean"
          },
          "scopeStatus": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScopeItemStateDto"
            }
          }
        },
        "required": [
          "id",
          "title",
          "revision",
          "selectionMode",
          "specificationSkipped",
          "scopeStatus",
          "items"
        ]
      },
      "ScopePatchDto": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "number",
            "minimum": 1
          },
          "selectionMode": {
            "type": "string",
            "enum": ["lot", "items"]
          },
          "specificationSkipped": {
            "type": "boolean"
          },
          "items": {
            "maxItems": 100,
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ScopeItemDto"
            }
          }
        },
        "required": ["revision"]
      },
      "SpecificationDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "description": "uploaded means waiting, not parsed"
          }
        },
        "required": ["id", "name", "status"]
      },
      "LotDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "ordinal": {
            "type": "number"
          }
        },
        "required": ["id", "name", "ordinal"]
      }
    }
  }
}
