{
  "name": "tender-platform",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "\u003e=24 \u003c25"
  },
  "scripts": {
    "dev:web": "npm run dev --workspace @tender/web",
    "dev:api": "npm run dev --workspace @tender/api",
    "build": "npm run build --workspace @tender/shared \u0026\u0026 npm run build --workspace @tender/api \u0026\u0026 npm run build --workspace @tender/web",
    "typecheck": "tsc -p packages/shared --noEmit \u0026\u0026 tsc -p apps/api --noEmit \u0026\u0026 vue-tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test:api \u0026\u0026 npm run test:web",
    "test:api": "jest --runInBand",
    "test:web": "vitest run --config apps/web/vite.config.ts",
    "test:e2e": "playwright test",
    "check": "npm run typecheck \u0026\u0026 npm run lint \u0026\u0026 npm test \u0026\u0026 npm run build"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "@fastify/multipart": "^9.0.0",
    "fastify": "5.12.8",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "ajv": "^8.17.1",
    "axios": "^1.12.0",
    "dotenv": "^17.0.0",
    "pdfjs-dist": "6.5.438",
    "pg": "8.23.1",
    "vue": "^3.5.0",
    "vue-router": "^4.5.0",
    "primevue": "^4.0.0",
    "@primeuix/themes": "^1.0.0",
    "primeicons": "^7.0.0",
    "@tanstack/vue-query": "^5.0.0",
    "vee-validate": "^4.15.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "typescript": "~5.9.0",
    "tsx": "^4.20.0",
    "@types/node": "^24.0.0",
    "@types/pg": "8.23.1",
    "vite": "^7.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "vue-tsc": "^3.0.0",
    "vitest": "5.0.5",
    "@vue/test-utils": "^2.4.6",
    "jsdom": "^26.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.0",
    "@types/jest": "^29.5.0",
    "@playwright/test": "^1.56.0",
    "eslint": "^9.0.0",
    "@eslint/js": "^9.0.0",
    "typescript-eslint": "^8.0.0",
    "eslint-plugin-vue": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0"
  },
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "$fastify"
    },
    "@nestjs/swagger": {
      "js-yaml": "5.5.0"
    },
    "fastify": "$fastify"
  }
}
