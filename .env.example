# Local development only. PostgreSQL and 1C connections are not configured.
PORT=3000
STORAGE_ROOT=C:/Users/oalimova/ai_project/temp/storage
# Fill in local .env. Never commit credentials.
PGHOST=localhost
PGPORT=5432
PGDATABASE=
PGUSER=
PGPASSWORD=
PGCONNECT_TIMEOUT=5

NODE_ENV=development
ENABLE_OPENAPI=false

# Enable only after migration review and test database approval. Disabled in production.
DATA_ACCESS_ENABLED=false
DEV_API_TOKEN=
DEV_ACTOR_ID=

# TASK-008: opt-in, only approved synthetic originals until separate document clearance.
DOCUMENT_AI_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3-vl:8b-instruct
OLLAMA_MODEL_DIGEST=
DOCUMENT_AI_TIMEOUT_MS=90000
# Comma-separated SHA-256 of synthetic originals reviewed by the operator; empty denies inference.
DOCUMENT_AI_SYNTHETIC_SHA256=
# TASK-009A: enable only after approved 003 migration and restarting all writers/workers.
TENDER_LIFECYCLE_ENABLED=false
